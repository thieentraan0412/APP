{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaptureShare",
  "version": "0.6.0",
  "identifier": "com.thiee.captureshare",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chụp & Chia sẻ",
        "width": 980,
        "height": 680,
        "minWidth": 700,
        "minHeight": 520,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,AsyncDns --disable-quic --no-proxy-server --dns-over-https-mode=off"
      },
      {
        "label": "rec_notify",
        "title": "",
        "url": "/",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "width": 260,
        "height": 54,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,AsyncDns --disable-quic --no-proxy-server --dns-over-https-mode=off"
      },
      {
        "label": "rec_border",
        "title": "",
        "url": "/",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "width": 100,
        "height": 100,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,AsyncDns --disable-quic --no-proxy-server --dns-over-https-mode=off"
      },
      {
        "label": "region_selector",
        "title": "",
        "url": "/",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "fullscreen": true,
        "skipTaskbar": true,
        "resizable": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,AsyncDns --disable-quic --no-proxy-server --dns-over-https-mode=off"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzNDJGNDYyN0VBNzZDOTkKUldTWmJLZCtZdlJDTThaSGlaMDNlS2dlSUF0QkRYbVFDQTFUa0lvcHJSUnBqanlsaGhqdmdGTEcK",
      "endpoints": [
        "https://github.com/thieentraan0412/APP/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
